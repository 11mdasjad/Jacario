# ==============================================================================
# JACARIO - Production & Staging Environment Configuration Template
# ==============================================================================
# Copy this file to .env on your hosting server (Hostinger) and fill in your actual credentials.
# NEVER commit the real .env file or production secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Core Configuration
# ------------------------------------------------------------------------------
APP_NAME="JACARIO"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# Database Configuration (Hostinger MySQL / MariaDB)
# ------------------------------------------------------------------------------
# On Hostinger hPanel -> Databases -> Management:
# Create a new MySQL database and database user, then assign permissions.
# Set DB_HOST to 127.0.0.1 or localhost.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_jacario
DB_USERNAME=u123456789_jacario_user
DB_PASSWORD=

# Alternative: Local development with SQLite
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# ------------------------------------------------------------------------------
# Session, Cache, & Queue Drivers
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
CACHE_PREFIX=

QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Optional Redis Cache / Queue (Hostinger Cloud or VPS)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Mail Configuration (Hostinger Webmail / Titan Mail / SMTP)
# ------------------------------------------------------------------------------
# For Hostinger Webmail / Titan:
# - Host: smtp.hostinger.com (or smtp.titan.email)
# - Port: 465 (SSL) or 587 (TLS)
# - Username: your full email address (e.g. concierge@yourdomain.com)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=concierge@yourdomain.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="concierge@yourdomain.com"
MAIL_FROM_NAME="JACARIO"

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway
# ------------------------------------------------------------------------------
# Leave empty to utilize Jacario's built-in simulation / mock testing mode.
# When ready for live transactions, obtain API keys from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Store Default Constants & Shipping
# ------------------------------------------------------------------------------
FREE_SHIPPING_THRESHOLD=1999
STANDARD_SHIPPING_FEE=150

# ------------------------------------------------------------------------------
# Google OAuth 2.0 (Social Authentication)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Authorized redirect URI: https://yourdomain.com/auth/google/callback
# Explicit URL used below to prevent unsupported dashboard variable interpolation.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback

# ------------------------------------------------------------------------------
# AWS S3 / Cloudflare R2 Object Storage (Optional for Media & Backups)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
