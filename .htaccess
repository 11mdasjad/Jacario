<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive configuration, codebase files, and databases
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|vite\.config\.js|artisan|phpunit\.xml|render\.yaml|Dockerfile|docker-compose\.yml|jacario\.sql) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/.*)?$ - [F,L,NC]

    # Rewrite all public web requests to the public/ directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Disable directory browsing
Options -Indexes
